# Casefolio configuration — copy to .env and fill in.

# Required for live AI generation. Without it, Casefolio runs in a built-in
# offline mode (deterministic questions + a basic case study) so you can still
# demo the full flow.
ANTHROPIC_API_KEY=

# Model used for the interview, vision captioning, and generation.
# Must be a vision-capable Claude model.
CASEFOLIO_MODEL=claude-sonnet-4-6

# Optional tuning
# CASEFOLIO_MAX_TOKENS=8000
# CASEFOLIO_MAX_UPLOAD_MB=8
# CASEFOLIO_DATA_DIR=./data
# CASEFOLIO_UPLOAD_DIR=./uploads
